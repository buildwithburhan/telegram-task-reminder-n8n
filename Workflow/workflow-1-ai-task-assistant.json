    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "=Hello {{ $json.firstName }}! 👋\n\nYour Chat ID: <code>{{ $json.chatId }}</code>\n\nI am your task assistant. Just talk to me normally, by text or voice note. For example:\n• Call the client tomorrow at 3 pm\n• What are my tasks today?\n• The client call is done",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
      "id": "5d7dc2a0-c05a-4f39-8c30-f75f29c5267c",
      "name": "Send Welcome + Chat ID",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        384,
        544
      ]
    },
    {
