    {
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "cachedResultName": "Boss Tasks",
          "mode": "id",
          "value": "YOUR_DATA_TABLE_ID"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "remindAt",
              "condition": "isNotEmpty"
            },
            {
              "keyName": "status",
              "keyValue": "Pending"
            }
          ]
        },
        "returnAll": true
      },
      "id": "d5f3f5b9-a609-40e7-a288-7039f4b02517",
      "name": "Read Tasks for Reminders",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        240,
        1104
      ]
    },
    {
      "parameters": {
        "jsCode": "const tz = 'Asia/Karachi';\nconst now = DateTime.now().setZone(tz);\nconst dot = { P1: '🔴', P2: '🟠', P3: '🟡', P4: '⚪' };\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst out = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (!r.taskId || !r.remindAt) continue;\n  if (String(r.status ?? '').trim() !== 'Pending') continue;\n  if (String(r.reminded ?? '').trim().toLowerCase() === 'yes') continue;\n  const at = DateTime.fromFormat(String(r.remindAt).trim(), 'yyyy-MM-dd HH:mm', { zone: tz });\n  if (!at.isValid) continue;\n  const minsLate = now.diff(at, 'minutes').minutes;\n  if (minsLate < 0 || minsLate > 360) continue;\n  const cat = String(r.category || r.aiSuggested || '').trim();\n  const message = '⏰ <b>Reminder</b>\\n\\n' + (dot[cat] || '📌') + ' ' + esc(r.task) + (cat ? ' (' + cat + ')' : '') + '\\n\\nYou asked me to remind you at ' + at.toFormat('h:mm a') + '. Reply \"done\" to this message when it is finished.';\n  out.push({ json: { taskId: r.taskId, message } });\n}\nreturn out;\n"
      },
